{
  "name": "@washbase/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fetch-spec": "node scripts/fetch-spec.mjs",
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "sync": "pnpm fetch-spec && pnpm generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
