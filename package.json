{
  "name": "washbase",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "pnpm --filter @washbase/web dev",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "api:serve": "node scripts/api.mjs serve",
    "api:client": "node scripts/api.mjs run -- pnpm --filter @washbase/api-client sync",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @washbase/web test:e2e",
    "try:open-prs": "node scripts/try-open-prs.mjs",
    "db:reset": "node scripts/db.mjs reset"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
